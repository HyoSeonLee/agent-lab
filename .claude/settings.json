{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./certs/**)",
      "Edit(./src/test/**)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/test-gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
